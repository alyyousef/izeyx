# Copy this file to .env.local for local development, or configure these as
# environment variables in Vercel (Project → Settings → Environment Variables).
#
# The contact form validates either way; without the email vars below it
# honestly reports that delivery isn't configured instead of faking a send.
# See src/lib/contact-mailer.ts and README.md "Contact form configuration".

# Where contact-form enquiries are delivered. Defaults to the public email in
# src/lib/site-config.ts (izeyxegy@gmail.com) when unset.
CONTACT_RECIPIENT_EMAIL=izeyxegy@gmail.com

# "From" address for the notification email. Must be authorised with Resend:
#   • Quick local test: sign up at https://resend.com with izeyxegy@gmail.com,
#     then use  IZEYX <onboarding@resend.dev>  (sandbox: only delivers to your
#     Resend account email until a domain is verified).
#   • Production: verify izeyx.com in Resend, then use e.g.
#     IZEYX Enquiries <hello@izeyx.com>
CONTACT_FROM_EMAIL=

# Resend API key from https://resend.com/api-keys (never exposed to the browser).
EMAIL_PROVIDER_API_KEY=

# Required in production. Use the public HTTPS origin only: no path, query, or
# credentials. Invalid/local values fail the production build. This drives
# canonical links, sitemap.xml, and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=https://www.izeyx.com

# Optional Sentry error monitoring. The app works without these values.
# Create a Sentry Next.js project, then provide its public DSN. Keep PII
# collection disabled unless the privacy policy and operational need change.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
NEXT_PUBLIC_APP_ENV=production

# Optional build-time source-map upload credentials. Configure these only in
# CI/hosting secrets; never expose SENTRY_AUTH_TOKEN to the browser.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
