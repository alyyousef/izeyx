{
  "name": "izeyx",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "serve:test": "next dev --hostname 127.0.0.1 --port 3100",
    "serve:test:ci": "next start --hostname 127.0.0.1 --port 3100",
    "test:e2e": "start-server-and-test serve:test http://127.0.0.1:3100 test:e2e:run",
    "test:e2e:ci": "start-server-and-test serve:test:ci http://127.0.0.1:3100 test:e2e:run",
    "test:e2e:run": "playwright test",
    "test:e2e:ui": "start-server-and-test serve:test http://127.0.0.1:3100 test:e2e:ui:run",
    "test:e2e:ui:run": "playwright test --ui"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.68.0",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "start-server-and-test": "^3.0.11",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
